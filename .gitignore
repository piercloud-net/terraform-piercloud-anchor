# OpenTofu
.terraform/
# Provider lock: the module ROOT's lock is committed deliberately (security
# N3) — it pins the community rixlhq/netcup provider for `tofu init
# -lockfile=readonly` in provision.yml and every CI init. Nested example locks
# stay ignored (they may resolve freely).
.terraform.lock.hcl
!/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Workflow-generated stateless import (import-apply-discard) — runtime only.
# No leading dot: HCL loaders ignore dotfiles (that bug made the import a no-op).
.workflow-import.tf
workflow-import.tf

# Local overrides / scratch
.local/
*.auto.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Secrets never belong in this repo
*.pem
*.key
.env

# Verification browser (tools/verification-browser): any browser profile is a
# credential store — never commit it. Separate lines (gitignore does not expand
# braces); the CfT download and logs are ignored too, in case BROWSER_HOME
# points inside the clone (the default lives outside it).
*-profile/
tools/verification-browser/cft/
tools/verification-browser/*.log
__pycache__/
